proc ::__is_obj {obj} {
    if {[get_instances $obj] != ""} {
        return 1
    }
    if {[get_nets $obj] != ""} {
        return 1
    }
    if {[get_ports $obj] != ""} {
        return 1
    }
    if {[get_pins $obj] != ""} {
        return 1
    }
    return 0
}
proc ::__s_to_e_obj {obj} {
    if {[llength $obj] == 1} {
        set obj {*}$obj
    }
    set tmp_obj [string map {" .\\" {`!} ".\\" {`!} " ." ` " " ""} $obj]
    set have_top [string match "[get_top].*" $tmp_obj]
    if {$have_top} {
        set tmp_obj [string range $tmp_obj [string length [get_top]]+1 end]
    }
    # if {[string match {*\*.*\}} $obj]} {
    #     lassign [split [string map {} [ } $tmp_obj] `}] BN S _
    #     set result [concat {*}[lmap i [concat {*}[split $S ,]] {::__s_to_e_obj [format "$BN\\[%s\\]" $i]}]]
    #     return $result
    # }
    set str_list ""
    foreach i [split $tmp_obj "`"] {
        if {[string first {!} $i] == 0} {
            set l_i [string range $i 1 end]
        } else {
            set l_i [split $i .]
        }
        foreach j $l_i {
            if {[string match {*\[[a-zA-Z_]*} $j]} {
                set j [regsub -all {\[([a-zA-Z_]\w*)\]} $j {.\1}]
            }
            lappend str_list $j
        }
    }
    if {[get_param db.use_hier_name_include_top] == "true"} {
        set result [get_top]
    } else {
        set result ""
    }
    set idx 0
    while {1} {
        set sub_str_i [lindex $str_list $idx]
        if {$sub_str_i == ""} {break}
        incr idx
        set tmp [join [concat $result $sub_str_i] /]
        if {[::__is_obj $tmp]} {
            set result $tmp
            continue
        }
        set di {CLR r PRE s EN s D d Q q CP clk}
        if {[dict exists $di $sub_str_i]} {
            set tmp [join [concat $result [dict get $di $sub_str_i]] /]
            if {[::__is_obj $tmp]} {
                set result $tmp
                continue
            }
        }
        if {[string match {rtlc_I*} $sub_str_i]} {
            set tmp [join [concat $result [string map {rtlc_I i} $sub_str_i]] /]
            if {[::__is_obj $tmp]} {
                set result $tmp
                continue
            }
        }
        if {[string match {*_reg} $sub_str_i]} {
            set tmp [join [concat $result [string range $sub_str_i 0 end-4]] /]
            if {[::__is_obj $tmp]} {
                set result $tmp
                continue
            }
        }
        if {[string match {*_reg\[[0-9]*} $sub_str_i]} {
            set tmp [join [concat $result [string map {_reg[ [} $sub_str_i]] /]
            if {[::__is_obj $tmp]} {
                set result $tmp
                continue
            }
        }
        return $obj
    }
    set result [concat {*}$result]
    return $result
}

proc get_canonical_obj {obj_list} {
    set enno_id $::compare::ennoid
    if {${enno_id} == "E0233"} {
        set clock [lindex ${obj_list} 0]
        if {[regexp {\[[0-9]+:[0-9]+\]} $clock]} {
            return ${obj_list}
        }
        set clock [get_nets ${clock} -canonical]
        set obj_list [concat ${clock} [lindex ${obj_list} 1]]
        return ${obj_list}
    }
}
