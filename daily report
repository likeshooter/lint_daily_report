proc delete_heri {object} {
    set newObjects [list]
    set obj [lindex $object 0]
    if {[regexp {.*(genblk[0-9]*.*)} $obj match newobj] == 1} {
        set newObjects [lreplace $object 0 0 $newobj]
        puts $newObjects
    } else {
        if {$::compare::ennoid == "E0331"} {
            set objs [split $obj "/"]
            set newObjects [lreplace $object 0 0 [lindex $objs end]]
        } else {
            set objs [split $obj "/."]
            set newObjects [lreplace $object 0 0 [lindex $objs end]]
        }
    }
    return $newObjects
}

# 输入enno已经匹配的msg的索引，以及enno-msg的个数，获取没有匹配的msg
proc get_extra_index {match_list length} {
    set all_index [list]
    for {set index 0} {$index < $length} {incr index} {
        lappend all_index $index
    }
    set match_list [lsort $match_list]

    set result {}
    foreach elem $all_index {
        if {$elem ni $match_list} {
            lappend result $elem
        }
    }
    return ${result}
}

